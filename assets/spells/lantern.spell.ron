// Lantern: slot-selectable spell with two casts, both server-authoritative.
//   - throw  (Q): client sends ThrowLanternMessage; server spawns the
//                 lantern entity, runs physics, replicates back.
//   - pickup (E): client sends PickupLanternMessage with its own
//                 position; server despawns lanterns in pickup radius.
// Cap (3 lanterns per client) is enforced server-side.
SpellDef(
    id: "lantern",
    label: "Lantern",
    casts: [
        (
            id: "lantern.throw",
            label: "Throw",
            trigger: Press(action: ThrowLantern),
            charging: Charging(
                source: Time(duration: 0.35),
                min_release: 1.0,
                max_charge: 1.0,
            ),
            payload: Custom(handler: "lantern.throw"),
        ),
        (
            id: "lantern.pickup",
            label: "Pickup",
            trigger: Press(action: Pickup),
            charging: Charging(
                source: Time(duration: 0.2),
                min_release: 1.0,
                max_charge: 1.0,
            ),
            payload: Custom(handler: "lantern.pickup"),
        ),
    ],
)
