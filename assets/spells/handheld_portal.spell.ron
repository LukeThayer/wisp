// Handheld Portal: hold Fire (or FireSecondary) to wind up, then channel
// while held — a real `NetworkedPortal` is server-spawned for the slot
// and floats directly in front of the wizard's camera. The wizard can
// walk around with it; through-portal rendering + server-authoritative
// teleport work the same as any other portal. Releasing the button
// despawns it. Wind-up uses the engine's `Hold + Charging` semantics
// (matches `Charging.max_charge` to promote to Channeling); release
// during wind-up cancels back to Idle.
SpellDef(
    id: "handheld_portal",
    label: "Handheld Portal",
    tint: Some((r: 0.85, g: 0.55, b: 1.0)),
    casts: [
        (
            id: "handheld_portal.hold_primary",
            label: "Primary",
            trigger: Hold(action: Fire),
            charging: Charging(
                source: Time(duration: 0.6),
                min_release: 1.0,
                max_charge: 1.0,
            ),
            payload: Custom(handler: "handheld_portal.hold_primary"),
        ),
        (
            id: "handheld_portal.hold_secondary",
            label: "Secondary",
            trigger: Hold(action: FireSecondary),
            charging: Charging(
                source: Time(duration: 0.6),
                min_release: 1.0,
                max_charge: 1.0,
            ),
            payload: Custom(handler: "handheld_portal.hold_secondary"),
        ),
    ],
)
